<?xml version="1.0"?>
<ruleset name="applink">
    <description>PSR-12 coding standard for applink</description>

    <file>bin</file>
    <file>public</file>
    <file>src</file>
    <file>tests</file>

    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="PSR12"/>

    <!-- Templates mix PHP and HTML, which the PSR-12 file header rules do not cover -->
    <rule ref="PSR12.Files.FileHeader">
        <exclude-pattern>*.html.php</exclude-pattern>
    </rule>
    <rule ref="Generic.Files.LineLength">
        <exclude-pattern>*.html.php</exclude-pattern>
    </rule>
</ruleset>
