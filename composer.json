{
    "name": "smartcompanion/applink",
    "type": "project",
    "description": "One shareable link to all your app market listings",
    "keywords": ["applink", "app store", "google play", "deep link", "redirect", "qr code"],
    "homepage": "https://github.com/smartcompanion-app/applink",
    "license": "BSD-2-Clause",
    "authors": [
        {
            "name": "Stefan Huber",
            "homepage": "https://github.com/stefanhuber"
        }
    ],
    "require": {
        "php": "^8.4",
        "symfony/yaml": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "phpstan/phpstan": "^2.3",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "SmartCompanion\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SmartCompanion\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "analyse": "phpstan analyse --memory-limit=512M",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "APPLINK_STORAGE=docs/example_storage php -S localhost:8080 -t public bin/dev-router.php"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit test suite",
        "lint": "Check PSR-12 code style",
        "lint:fix": "Fix PSR-12 code style violations",
        "analyse": "Run PHPStan static analysis",
        "check": "Run code style, static analysis and tests",
        "serve": "Serve the example configuration on http://localhost:8080"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
